<?xml version="1.0" encoding="UTF-8"?>
<!--
	两个语言版本各占一条 <url>，并且每条都用 xhtml:link 列出全部版本（含自己）。
	这份互相指认必须和页面里的 <link rel="alternate"> 一致 ——
	对不上的话 Google 会把整组 hreflang 标注当作无效丢掉。
-->
<urlset
	xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
	xmlns:xhtml="http://www.w3.org/1999/xhtml"
>
	<url>
		<loc>https://dsh-desktop.cc.cd/</loc>
		<xhtml:link rel="alternate" hreflang="zh-CN" href="https://dsh-desktop.cc.cd/" />
		<xhtml:link rel="alternate" hreflang="en" href="https://dsh-desktop.cc.cd/en/" />
		<xhtml:link rel="alternate" hreflang="x-default" href="https://dsh-desktop.cc.cd/" />
		<!-- 内容有实质变动时手动更新这个日期；写成构建日期会让它永远"刚更新过"，
		     搜索引擎发现日期不可信之后就会整体忽略 lastmod。 -->
		<lastmod>2026-09-04</lastmod>
		<changefreq>weekly</changefreq>
		<priority>1.0</priority>
	</url>
	<url>
		<loc>https://dsh-desktop.cc.cd/en/</loc>
		<xhtml:link rel="alternate" hreflang="zh-CN" href="https://dsh-desktop.cc.cd/" />
		<xhtml:link rel="alternate" hreflang="en" href="https://dsh-desktop.cc.cd/en/" />
		<xhtml:link rel="alternate" hreflang="x-default" href="https://dsh-desktop.cc.cd/" />
		<lastmod>2026-09-04</lastmod>
		<changefreq>weekly</changefreq>
		<priority>0.9</priority>
	</url>
</urlset>
