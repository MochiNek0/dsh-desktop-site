{
  // 站点主体仍是 vite build 产出的静态资源；Worker 只挂了三个 /api 路由
  // （/api/click 收下载点击、/api/visit 收访客、/api/daily 给每日汇总脚本读，
  // 见 worker/index.ts）。静态资源命中时 Worker 根本不会执行，
  // 所以页面的响应路径和纯静态时期没有区别。
  //
  // ⚠️ "name" 必须和 Cloudflare 面板里 Worker 的名字一致，否则会部署到另一个 Worker。
  "name": "dsh-desktop-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-03",

  // 只从自定义域提供服务。
  //
  // 关掉 workers.dev 是个 SEO 决定：同一份内容同时挂在
  // dsh-desktop-site.<sub>.workers.dev 和 dsh-desktop.cc.cd 上，
  // 就是两个可被抓取的重复站点。canonical 能缓解但不保证，
  // 而这个预览域名本来也没在任何地方对外给出。
  "workers_dev": false,
  "routes": [
    {
      // dsh-desktop.cc.cd 本身就是一个 Cloudflare zone（NS 已委派），
      // 所以这里绑的是该 zone 的根，不是 cc.cd 的子域路由。
      "pattern": "dsh-desktop.cc.cd",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./build",
    // 有 main 之后必须给 binding，Worker 才能把非 /api 请求交回静态资源
    "binding": "ASSETS",
    // 真实存在的路径（/）已预渲染；
    // 真正不存在的地址应该返回 404，而不是拿首页顶包。
    // adapter-static 的 fallback 就是 404.html。
    "not_found_handling": "404-page",
    // ⚠️ run_worker_first 写成路径清单后就是一个白名单：只有列出的路径会进 Worker，
    // 其余未命中静态资源的请求（浏览器导航请求）直接拿 404.html。
    // /api/* 在静态资源里本来就不存在，以前靠「未命中就进 Worker」兜底；
    // 一旦有了这份清单就必须显式列出，否则 /api/visit、/api/click、/api/daily
    // 全都会 404 —— 2026-10-26 加这份清单时只列了旧链接 301 的路径，
    // 把三个 API 一起漏掉了（见 fb803f3 的教训）。
    "run_worker_first": ["/api/*", "/blog", "/blog/*", "/docs/code-signing*", "/en/docs/code-signing*"]
  },

  // 下载点击流水。建库：wrangler d1 create dsh-desktop-site-stats
  // 建表：wrangler d1 migrations apply DB --remote
  // ⚠️ database_id 要换成 d1 create 输出的那个 uuid，占位值部署会失败。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsh-desktop-site-stats",
      "database_id": "14d3c226-8b04-4bac-bfd8-542f695e8271",
      "migrations_dir": "migrations"
    }
  ]
}
